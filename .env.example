# FireInSite environment variables — copy to .env and fill in.
# Set the same variables in the Vercel project settings (Production + Preview).

# --- Client-side keys (VITE_ prefix → bundled into the browser build) ---------
# These are exposed to the client by design; restrict them by domain/referrer in
# each provider's dashboard where possible.

# Mapbox GL access token — interactive map (src/lib/components/ui/Map.svelte)
VITE_MAPBOX_GL_TOKEN=

# Geoapify token — IP-based geolocation fallback (src/lib/shared/stores/locationStore.js)
VITE_GEOAPIFY_TOKEN=

# UK Met Office Global Spot API key — Met Office weather source (src/lib/weather/metoffice.js)
VITE_METOFFICE_GLOBAL_API_KEY=

# --- Server-side keys (NO VITE_ prefix → never sent to the browser) -----------

# Open-Meteo customer (paid) forecast API key. Read at runtime by the server
# proxy at src/routes/api/forecast/+server.js, which attaches it to forecast
# requests to customer-api.open-meteo.com so the key stays off the client.
# Open-Meteo has no domain/referrer key restriction, so it MUST NOT be a VITE_
# variable. If unset, the proxy falls back to the free forecast endpoint, so the
# app still works locally without a key (just slower / free-tier rate limits).
# Historical/ERA5 archive calls use no key and are not proxied.
OPENMETEO_API_KEY=
